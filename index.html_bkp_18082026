// ═══════════════════════════════════════════════════════════════
// NAVBAR SCROLL
// ═══════════════════════════════════════════════════════════════
window.addEventListener('scroll', () => {
    document.getElementById('mainNavbar').classList.toggle('scrolled', window.scrollY > 50);
});

// ═══════════════════════════════════════════════════════════════
// COUNTER ANIMATION
// ═══════════════════════════════════════════════════════════════
function animateCounter(el, target, suffix, duration) {
    let start = 0;
    const step = target / (duration / 16);
    const timer = setInterval(() => {
        start = Math.min(start + step, target);
        el.textContent = Math.floor(start).toLocaleString('en-IN') + suffix;
        if (start >= target) clearInterval(timer);
    }, 16);
}
setTimeout(() => {
    animateCounter(document.getElementById('statOutlets'), 15400, '+', 2000);
    animateCounter(document.getElementById('statLang'), 14, '', 1500);
    animateCounter(document.getElementById('statStories'), 48000, '+', 2500);
}, 800);

// ═══════════════════════════════════════════════════════════════
// LIVE COUNT
// ═══════════════════════════════════════════════════════════════
function animateLiveCount() {
    let target = 2847, current = 0;
    const el = document.getElementById('liveCount');
    const interval = setInterval(() => {
        current = Math.min(current + 47, target);
        el.textContent = current.toLocaleString('en-IN');
        if (current >= target) {
            clearInterval(interval);
            setInterval(() => {
                target += Math.floor(Math.random() * 3);
                el.textContent = target.toLocaleString('en-IN');
            }, 8000);
        }
    }, 20);
}
animateLiveCount();

// ═══════════════════════════════════════════════════════════════
// PULSE NODES
// ═══════════════════════════════════════════════════════════════
function createPulseNodes() {
    const container = document.getElementById('pulseNodes');
    if (!container) return;
    const positions = [
        {top:'10%',left:'50%'},{top:'25%',left:'85%'},{top:'50%',left:'95%'},
        {top:'75%',left:'85%'},{top:'90%',left:'50%'},{top:'75%',left:'15%'},
        {top:'50%',left:'5%'},{top:'25%',left:'15%'},{top:'15%',left:'30%'},
        {top:'15%',left:'70%'}
    ];
    positions.forEach((pos, i) => {
        const node = document.createElement('div');
        node.className = 'pulse-node';
        node.style.top = pos.top;
        node.style.left = pos.left;
        node.style.transform = 'translate(-50%,-50%)';
        node.style.animationDelay = (i * 0.3) + 's';
        container.appendChild(node);
    });
}
createPulseNodes();

// ═══════════════════════════════════════════════════════════════
// DASHBOARD TAB SWITCHING
// ═══════════════════════════════════════════════════════════════
function switchDashboard(index) {
    document.querySelectorAll('.dash-tab').forEach((tab, i) => {
        tab.classList.toggle('active', i === index);
    });
    document.querySelectorAll('.dashboard-preview').forEach((preview, i) => {
        preview.classList.toggle('active', i === index);
    });
}

// ═══════════════════════════════════════════════════════════════
// RSS FETCH
// ═══════════════════════════════════════════════════════════════
const proxies = ['https://api.allorigins.win/raw?url=', 'https://corsproxy.io/?'];
let proxyIndex = 0;

const rssSources = [
    {name:"The Hindu",url:"https://www.thehindu.com/feeder/default.rss",site:"https://www.thehindu.com/"},
    {name:"Times of India",url:"https://timesofindia.indiatimes.com/rssfeedstopstories.cms",site:"https://timesofindia.indiatimes.com/"},
    {name:"Hindustan Times",url:"https://www.hindustantimes.com/feeds/rss/india-news/rssfeed.xml",site:"https://www.hindustantimes.com/"},
    {name:"Economic Times",url:"https://economictimes.indiatimes.com/rssfeedstopstories.cms",site:"https://economictimes.indiatimes.com/"}
];

const fallbackArticles = [
    {title:"India's GDP growth forecast revised upward to 7.2% for FY26",link:"https://economictimes.indiatimes.com/",pubDate:"Just now",source:"Economic Times",sentiment:"positive"},
    {title:"Supreme Court upholds constitutional validity of DPDP Act, 2023",link:"https://www.thehindu.com/",pubDate:"2 hrs ago",source:"The Hindu",sentiment:"neutral"},
    {title:"SEBI introduces streamlined IPO framework for tech startups",link:"https://www.business-standard.com/",pubDate:"3 hrs ago",source:"Business Standard",sentiment:"positive"},
    {title:"RBI's new UPI guidelines set to transform digital payments",link:"https://www.livemint.com/",pubDate:"4 hrs ago",source:"LiveMint",sentiment:"positive"},
    {title:"India's renewable energy capacity surpasses 200 GW milestone",link:"https://timesofindia.indiatimes.com/",pubDate:"5 hrs ago",source:"Times of India",sentiment:"positive"},
    {title:"Cabinet approves ₹1.2 lakh crore PLI scheme for semiconductor sector",link:"https://www.hindustantimes.com/",pubDate:"6 hrs ago",source:"Hindustan Times",sentiment:"positive"},
    {title:"NCLT order on Byju's insolvency sets new precedent for EdTech",link:"https://www.financialexpress.com/",pubDate:"7 hrs ago",source:"Financial Express",sentiment:"negative"},
    {title:"Mumbai infrastructure spending rises 34% in Q4 FY26 budget allocation",link:"https://www.dnaindia.com/",pubDate:"8 hrs ago",source:"DNA India",sentiment:"positive"},
    {title:"Tata Group acquires majority stake in Air India Express, merger complete",link:"https://www.ndtv.com/",pubDate:"9 hrs ago",source:"NDTV Profit",sentiment:"positive"},
];

async function fetchWithProxy(url) {
    for (let i = 0; i < proxies.length; i++) {
        try {
            const res = await fetch(proxies[proxyIndex] + encodeURIComponent(url), {signal: AbortSignal.timeout(5000)});
            if (res.ok) return await res.text();
        } catch(e) {}
        proxyIndex = (proxyIndex + 1) % proxies.length;
    }
    throw new Error('Proxies failed');
}

function parseRSS(xmlText, sourceName, sourceSite) {
    const parser = new DOMParser();
    const xml = parser.parseFromString(xmlText, "text/xml");
    const items = Array.from(xml.querySelectorAll("item")).slice(0, 3);
    return items.map(item => {
        const raw = item.querySelector("pubDate")?.textContent;
        let dateStr = "Recently";
        if (raw) {
            try { dateStr = new Date(raw).toLocaleString('en-IN', {hour:'2-digit',minute:'2-digit',day:'numeric',month:'short'}); } catch(e) {}
        }
        const link = item.querySelector("link")?.textContent || sourceSite;
        const sentiments = ['positive','neutral','positive','neutral','negative'];
        return {
            title: item.querySelector("title")?.textContent?.replace(/<!\[CDATA\[|\]\]>/g,'').trim() || "No title",
            link: link,
            pubDate: dateStr,
            source: sourceName,
            sentiment: sentiments[Math.floor(Math.random()*sentiments.length)]
        };
    });
}

function sentimentClass(s) {
    return s === 'positive' ? 'sent-pos' : s === 'negative' ? 'sent-neg' : 'sent-neu';
}
function sentimentLabel(s) {
    return s === 'positive' ? '✓ Positive' : s === 'negative' ? '↓ Negative' : '— Neutral';
}

function renderNewsCards(articles) {
    const container = document.getElementById('newsShowcase');
    container.innerHTML = '';
    articles.slice(0, 9).forEach((a, i) => {
        const card = document.createElement('a');
        card.className = 'news-card';
        card.href = a.link;
        card.target = '_blank';
        card.rel = 'noopener noreferrer';
        card.setAttribute('data-aos', 'fade-up');
        card.setAttribute('data-aos-delay', (i * 100).toString());
        card.innerHTML = `
            <div class="news-source"><span class="news-source-dot"></span>${a.source}</div>
            <div class="news-headline">${a.title}</div>
            <div style="margin-bottom:14px;">
                <span class="news-sentiment ${sentimentClass(a.sentiment)}">${sentimentLabel(a.sentiment)}</span>
            </div>
            <div class="news-meta">
                <span class="news-time">${a.pubDate}</span>
                <span class="news-link">Read <i class="fa-solid fa-arrow-right fa-xs"></i></span>
            </div>
        `;
        container.appendChild(card);
    });
    AOS.refresh();
    document.getElementById('rssTime').textContent = new Date().toLocaleTimeString('en-IN');
}

async function loadRSS() {
    let allArticles = [];
    for (const source of rssSources) {
        try {
            const xml = await fetchWithProxy(source.url);
            const parsed = parseRSS(xml, source.name, source.site);
            allArticles = allArticles.concat(parsed);
        } catch(e) {}
    }
    if (allArticles.length < 3) allArticles = fallbackArticles;
    renderNewsCards(allArticles);
}

loadRSS();
setInterval(loadRSS, 7200000);

// ═══════════════════════════════════════════════════════════════
// SCROLL TO TOP
// ═══════════════════════════════════════════════════════════════
