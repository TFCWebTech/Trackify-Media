<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrackifyMedia — Global Media Intelligence Platform</title>
    <meta name="description" content="Enterprise-grade media monitoring for PR firms & corporates worldwide. Real-time tracking across 50,000+ sources in 40+ languages.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --primary: #FF6B35; --primary-light: #FF8C5A; --primary-dark: #E55A2B; --primary-glow: rgba(255,107,53,0.3);
            --secondary: #1A1A2E; --secondary-light: #2D2D44;
            --accent: #00C9A7; --accent-light: #4DD4B8;
            --warning: #FFC857; --danger: #E63946; --info: #3B82F6;
            --bg: #FAFBFC; --bg-elevated: #F0F2F5; --surface: #FFFFFF; --surface-hover: #F8F9FA; --surface-elevated: #F5F7FA;
            --text-primary: #0F0F1A; --text-secondary: #6B7280; --text-muted: #9CA3AF;
            --border: #E5E7EB; --border-light: #F3F4F6;
            --shadow-color: rgba(0,0,0,0.08); --card-shadow: 0 4px 20px rgba(0,0,0,0.06);
            --gradient-primary: linear-gradient(135deg,#FF6B35,#FF8C5A,#FFC857);
            --gradient-dark: linear-gradient(135deg,#1A1A2E,#2D2D44);
            --gradient-glass: linear-gradient(135deg,rgba(255,255,255,0.9),rgba(255,255,255,0.7));
            --nav-bg: rgba(250,251,252,0.85); --footer-bg: #0a0a14; --legal-bg: #1A1A2E; --pulse-bg: #1A1A2E; --ticker-bg: #1A1A2E;
        }
        [data-theme="dark"] {
            --bg: #0a0a12; --bg-elevated: #12121f; --surface: #16162a; --surface-hover: #1e1e3a; --surface-elevated: #1a1a32;
            --text-primary: #F1F5F9; --text-secondary: #94A3B8; --text-muted: #64748B;
            --border: #2a2a4a; --border-light: #1e1e3a;
            --shadow-color: rgba(0,0,0,0.3); --card-shadow: 0 4px 20px rgba(0,0,0,0.3);
            --gradient-glass: linear-gradient(135deg,rgba(22,22,42,0.95),rgba(22,22,42,0.8));
            --nav-bg: rgba(10,10,18,0.85); --footer-bg: #05050a; --legal-bg: #0d0d1a; --pulse-bg: #0d0d1a; --ticker-bg: #0d0d1a;
        }
        *{margin:0;padding:0;box-sizing:border-box}
        html{scroll-behavior:smooth}
        body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:var(--bg);color:var(--text-primary);overflow-x:hidden;line-height:1.6;-webkit-font-smoothing:antialiased;transition:background .4s,color .4s}
        ::selection{background:rgba(255,107,53,0.25);color:var(--primary)}
        ::-webkit-scrollbar{width:8px}
        ::-webkit-scrollbar-track{background:var(--bg)}
        ::-webkit-scrollbar-thumb{background:var(--border);border-radius:999px}
        ::-webkit-scrollbar-thumb:hover{background:var(--text-muted)}

        /* Theme Toggle */
        .theme-toggle{width:44px;height:44px;border-radius:12px;border:2px solid var(--border);background:var(--surface);color:var(--text-secondary);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;transition:all .3s;position:relative;overflow:hidden}
        .theme-toggle:hover{border-color:var(--primary);color:var(--primary);transform:scale(1.05)}
        .theme-toggle .fa-sun{display:none}
        [data-theme="dark"] .theme-toggle .fa-sun{display:block}
        [data-theme="dark"] .theme-toggle .fa-moon{display:none}

        /* Clip Showcase - Running Newspaper Cards */
        .clip-showcase{background:var(--bg-elevated);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:60px 0;overflow:hidden;position:relative}
        .clip-showcase::before{content:'';position:absolute;left:0;top:0;bottom:0;width:150px;background:linear-gradient(90deg,var(--bg-elevated),transparent);z-index:10;pointer-events:none}
        .clip-showcase::after{content:'';position:absolute;right:0;top:0;bottom:0;width:150px;background:linear-gradient(270deg,var(--bg-elevated),transparent);z-index:10;pointer-events:none}
        .clip-track{display:flex;gap:24px;animation:clipScroll 25s linear infinite;width:max-content}
        .clip-track:hover{animation-play-state:paused}
        @keyframes clipScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
        .clip-item{flex-shrink:0;width:320px;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px;transition:all .4s;cursor:pointer;position:relative;overflow:hidden}
        .clip-item:hover{transform:translateY(-8px) scale(1.02);box-shadow:var(--card-shadow),0 0 30px var(--primary-glow);border-color:var(--primary)}
        .clip-item::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-primary);transform:scaleX(0);transition:transform .4s}
        .clip-item:hover::before{transform:scaleX(1)}
        .clip-header{display:flex;align-items:center;gap:10px;margin-bottom:14px}
        .clip-favicon{width:32px;height:32px;border-radius:8px;background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;font-size:14px;color:white;font-weight:700}
        .clip-source{font-size:12px;font-weight:700;color:var(--primary);letter-spacing:.05em;text-transform:uppercase}
        .clip-headline{font-family:'Instrument Serif',Georgia,serif;font-size:17px;font-weight:400;line-height:1.4;color:var(--text-primary);margin-bottom:12px}
        .clip-meta{display:flex;align-items:center;justify-content:space-between}
        .clip-time{font-size:11px;color:var(--text-muted);font-weight:500}
        .clip-sentiment{font-size:10px;font-weight:700;padding:3px 10px;border-radius:999px}
        .clip-img-preview{width:100%;height:140px;background:var(--bg-elevated);border-radius:10px;margin-bottom:14px;display:flex;align-items:center;justify-content:center;font-size:48px;position:relative;overflow:hidden}
        .clip-img-preview::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,107,53,0.1) 100%)}

        /* Dashboard Showcase */
        .dashboard-showcase{padding:100px 0;background:var(--bg);overflow:hidden}
        .dashboard-tabs{display:flex;gap:12px;justify-content:center;margin-bottom:48px;flex-wrap:wrap}
        .dash-tab{padding:12px 24px;border-radius:999px;border:2px solid var(--border);background:var(--surface);color:var(--text-secondary);font-size:14px;font-weight:600;cursor:pointer;transition:all .3s}
        .dash-tab:hover{border-color:var(--primary);color:var(--primary)}
        .dash-tab.active{background:var(--gradient-primary);border-color:transparent;color:white;box-shadow:0 4px 15px rgba(255,107,53,0.4)}
        .dashboard-preview-wrap{position:relative;max-width:1100px;margin:0 auto;perspective:1500px}
        .dashboard-preview{background:var(--surface);border:1px solid var(--border);border-radius:24px;box-shadow:var(--card-shadow),0 0 60px var(--primary-glow);overflow:hidden;transition:all .6s cubic-bezier(.23,1,.32,1);display:none}
        .dashboard-preview.active{display:block;animation:dashFadeIn .6s ease}
        @keyframes dashFadeIn{from{opacity:0;transform:translateY(20px) rotateX(5deg)}to{opacity:1;transform:translateY(0) rotateX(0)}}
        .dash1-top{background:var(--gradient-dark);padding:20px 28px;display:flex;align-items:center;justify-content:space-between}
        .dash1-body{padding:28px}
        .dash1-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
        .dash1-metric{background:var(--surface-elevated);border-radius:14px;padding:20px;text-align:center;border:1px solid var(--border-light);transition:all .3s}
        .dash1-metric:hover{border-color:var(--primary);transform:translateY(-3px);box-shadow:0 8px 24px var(--shadow-color)}
        .dash1-metric-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 12px}
        .dash1-metric-value{font-family:'Instrument Serif',Georgia,serif;font-size:28px;font-weight:600;color:var(--primary);line-height:1}
        .dash1-metric-label{font-size:11px;color:var(--text-muted);font-weight:600;margin-top:6px;letter-spacing:.05em;text-transform:uppercase}
        .dash1-metric-change{font-size:12px;font-weight:700;margin-top:4px}
        .change-up{color:var(--accent)}.change-down{color:var(--danger)}
        .dash1-chart-wrap{background:var(--surface-elevated);border-radius:16px;padding:24px;border:1px solid var(--border-light)}
        .dash1-chart-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
        .dash1-chart-title{font-size:14px;font-weight:700;color:var(--text-primary);letter-spacing:.05em}
        .dash1-chart-legend{display:flex;gap:16px}
        .legend-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);font-weight:600}
        .legend-dot{width:8px;height:8px;border-radius:50%}
        .svg-chart{width:100%;height:200px}
        .chart-line{fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
        .chart-line-1{stroke:var(--primary)}.chart-line-2{stroke:var(--accent)}
        .chart-area{opacity:.1}.chart-area-1{fill:var(--primary)}.chart-area-2{fill:var(--accent)}
        .chart-point{fill:var(--surface);stroke-width:3;r:5;transition:r .3s}
        .chart-point:hover{r:8}
        .chart-grid-line{stroke:var(--border);stroke-width:1;stroke-dasharray:4 4}
        .chart-axis-text{font-size:10px;fill:var(--text-muted);font-weight:500}

        /* Dash 2 - Bar Chart */
        .dash2-bars{display:flex;align-items:flex-end;gap:12px;height:220px;padding:20px 0}
        .dash2-bar-group{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px}
        .dash2-bar{width:100%;max-width:50px;background:var(--gradient-primary);border-radius:8px 8px 0 0;position:relative;transition:all .4s;animation:barGrowUp 1.5s ease-out forwards;transform-origin:bottom}
        .dash2-bar:hover{filter:brightness(1.15);box-shadow:0 0 20px var(--primary-glow)}
        .dash2-bar::after{content:attr(data-val);position:absolute;top:-24px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:700;color:var(--text-secondary);opacity:0;transition:opacity .3s}
        .dash2-bar:hover::after{opacity:1}
        @keyframes barGrowUp{from{transform:scaleY(0)}to{transform:scaleY(1)}}
        .dash2-bar-label{font-size:11px;color:var(--text-muted);font-weight:600}

        /* Dash 3 - Sentiment Wheel */
        .sentiment-wheel{width:200px;height:200px;position:relative;margin:0 auto}
        .wheel-svg{transform:rotate(-90deg)}
        .wheel-track{fill:none;stroke:var(--border);stroke-width:20}
        .wheel-progress{fill:none;stroke-width:20;stroke-linecap:round;stroke-dasharray:565;stroke-dashoffset:565;animation:wheelFill 2s ease-out forwards}
        @keyframes wheelFill{to{stroke-dashoffset:var(--wheel-offset,85)}}
        .wheel-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
        .wheel-value{font-family:'Instrument Serif',Georgia,serif;font-size:36px;font-weight:600;color:var(--primary)}
        .wheel-label{font-size:11px;color:var(--text-muted);font-weight:600}

        /* Dash 4 - World Map */
        .map-container{position:relative;height:300px;background:var(--bg-elevated);border-radius:16px;overflow:hidden}
        .map-dot{position:absolute;width:8px;height:8px;background:var(--primary);border-radius:50%;animation:mapPulse 2s ease-in-out infinite}
        @keyframes mapPulse{0%,100%{transform:scale(1);box-shadow:0 0 0 0 var(--primary-glow)}50%{transform:scale(1.5);box-shadow:0 0 0 10px transparent}}
        .map-label{position:absolute;font-size:10px;font-weight:700;color:var(--text-muted);background:var(--surface);padding:2px 8px;border-radius:4px;border:1px solid var(--border)}

        /* Base */
        .font-serif{font-family:'Instrument Serif',Georgia,serif}
        .gradient-text{background:var(--gradient-primary);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
        .btn-primary-custom{display:inline-flex;align-items:center;gap:10px;background:var(--gradient-primary);color:white;padding:14px 32px;border-radius:12px;font-weight:600;font-size:15px;border:none;cursor:pointer;transition:all .3s;text-decoration:none;box-shadow:0 4px 15px rgba(255,107,53,0.4)}
        .btn-primary-custom:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(255,107,53,0.5);color:white}
        .btn-secondary-custom{display:inline-flex;align-items:center;gap:10px;background:var(--surface);color:var(--text-primary);padding:14px 32px;border-radius:12px;font-weight:600;font-size:15px;border:2px solid var(--border);cursor:pointer;transition:all .3s;text-decoration:none}
        .btn-secondary-custom:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-2px);box-shadow:0 10px 25px var(--shadow-color)}
        .btn-dark-custom{display:inline-flex;align-items:center;gap:8px;background:var(--secondary);color:white;padding:10px 22px;border-radius:8px;font-weight:600;font-size:13px;border:none;cursor:pointer;transition:all .3s;text-decoration:none}
        .btn-dark-custom:hover{background:var(--secondary-light);transform:translateY(-1px)}

        /* Navbar */
        .navbar-custom{position:fixed;top:0;left:0;right:0;z-index:1000;background:var(--nav-bg);backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid var(--border);padding:0;transition:all .3s}
        .navbar-custom.scrolled{box-shadow:0 4px 20px var(--shadow-color)}
        .navbar-inner{max-width:1400px;margin:0 auto;padding:0 24px;height:72px;display:flex;align-items:center;justify-content:space-between}
        .navbar-brand-custom{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--text-primary)}
        .brand-icon{width:42px;height:42px;background:var(--gradient-primary);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;box-shadow:0 4px 12px var(--primary-glow);animation:brandPulse 3s ease-in-out infinite}
        @keyframes brandPulse{0%,100%{box-shadow:0 4px 12px var(--primary-glow)}50%{box-shadow:0 4px 24px rgba(255,107,53,0.5)}}
        .brand-text{font-family:'Instrument Serif',Georgia,serif;font-size:26px;font-weight:400;letter-spacing:-.02em}
        .brand-text span{color:var(--primary);font-weight:600}
        .nav-links{display:flex;align-items:center;gap:36px}
        .nav-links a{font-size:14px;font-weight:500;color:var(--text-secondary);text-decoration:none;transition:color .2s;position:relative}
        .nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--gradient-primary);transition:width .3s;border-radius:999px}
        .nav-links a:hover{color:var(--primary)}
        .nav-links a:hover::after{width:100%}
        .nav-actions{display:flex;align-items:center;gap:12px}

        /* Hero */
        .hero-section{min-height:100vh;display:flex;align-items:center;position:relative;overflow:hidden;padding-top:72px;background:var(--bg)}
        .hero-bg-pattern{position:absolute;inset:0;background-image:radial-gradient(circle at 20% 50%,rgba(255,107,53,0.06) 0%,transparent 50%),radial-gradient(circle at 80% 20%,rgba(0,201,167,0.04) 0%,transparent 50%),radial-gradient(circle at 50% 80%,rgba(255,200,87,0.03) 0%,transparent 50%);pointer-events:none}
        .hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:60px 60px;opacity:.3;pointer-events:none}
        .hero-content{max-width:1400px;margin:0 auto;padding:80px 40px;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:2}
        .hero-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(255,107,53,0.1);border:1px solid rgba(255,107,53,0.2);padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;color:var(--primary);margin-bottom:32px}
        .hero-badge .pulse-dot{width:8px;height:8px;background:var(--accent);border-radius:50%;animation:pulseDot 2s ease-in-out infinite}
        @keyframes pulseDot{0%,100%{box-shadow:0 0 0 0 rgba(0,201,167,0.6)}50%{box-shadow:0 0 0 8px rgba(0,201,167,0)}}
        .hero-title{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(42px,5.5vw,72px);font-weight:400;line-height:1.05;letter-spacing:-.03em;color:var(--text-primary);margin-bottom:24px}
        .hero-title .highlight{color:var(--primary);font-weight:600}
        .hero-title .highlight-alt{color:var(--secondary);font-weight:600}
        [data-theme="dark"] .hero-title .highlight-alt{color:var(--primary-light)}
        .hero-subtitle{font-size:18px;color:var(--text-secondary);max-width:520px;line-height:1.7;margin-bottom:40px}
        .hero-ctas{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:48px}
        .hero-stats-row{display:flex;gap:40px;flex-wrap:wrap}
        .hero-stat-item{display:flex;flex-direction:column;gap:4px}
        .hero-stat-num{font-family:'Instrument Serif',Georgia,serif;font-size:36px;font-weight:600;color:var(--primary);line-height:1}
        .hero-stat-label{font-size:12px;color:var(--text-muted);font-weight:600;letter-spacing:.08em;text-transform:uppercase}

        /* Hero Dashboard */
        .hero-visual{position:relative;perspective:1200px}
        .dashboard-card{background:var(--surface);border:1px solid var(--border);border-radius:24px;box-shadow:var(--card-shadow),0 0 60px var(--primary-glow);overflow:hidden;animation:dashboardFloat 6s ease-in-out infinite;transform:rotateY(-8deg) rotateX(4deg);transition:transform .5s}
        .dashboard-card:hover{transform:rotateY(-4deg) rotateX(2deg) translateY(-5px)}
        @keyframes dashboardFloat{0%,100%{transform:rotateY(-8deg) rotateX(4deg) translateY(0)}50%{transform:rotateY(-6deg) rotateX(3deg) translateY(-12px)}}
        .dash-header{background:var(--gradient-dark);padding:16px 24px;display:flex;align-items:center;justify-content:space-between}
        .dash-header-dots{display:flex;gap:8px}
        .dash-dot{width:12px;height:12px;border-radius:50%}
        .dash-dot-red{background:#FF5F57}.dash-dot-yellow{background:#FFBD2E}.dash-dot-green{background:#28C840}
        .dash-header-title{color:rgba(255,255,255,0.5);font-size:13px;font-weight:500}
        .dash-header-live{display:flex;align-items:center;gap:8px;color:var(--accent);font-size:12px;font-weight:600}
        .dash-header-live span{width:8px;height:8px;background:var(--accent);border-radius:50%;animation:livePulse 1.5s ease-in-out infinite}
        @keyframes livePulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(0,201,167,0.6)}50%{opacity:.7;box-shadow:0 0 0 6px rgba(0,201,167,0)}}
        .dash-body{padding:24px}
        .dash-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
        .dash-metric-box{background:var(--surface-elevated);border-radius:12px;padding:16px;text-align:center;transition:all .3s;border:1px solid var(--border-light)}
        .dash-metric-box:hover{border-color:var(--primary);transform:translateY(-2px);box-shadow:0 8px 24px var(--shadow-color)}
        .dash-metric-value{font-family:'Instrument Serif',Georgia,serif;font-size:28px;font-weight:600;color:var(--primary);line-height:1}
        .dash-metric-label{font-size:11px;color:var(--text-muted);font-weight:600;margin-top:6px;letter-spacing:.05em}
        .dash-chart-area{background:var(--surface-elevated);border-radius:12px;padding:20px;margin-bottom:20px;border:1px solid var(--border-light)}
        .dash-chart-title{font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px}
        .chart-container{display:flex;align-items:flex-end;gap:8px;height:100px}
        .chart-bar-item{flex:1;background:var(--gradient-primary);border-radius:4px 4px 0 0;animation:chartGrow 1.2s ease-out forwards;transform-origin:bottom;position:relative;transition:all .3s}
        .chart-bar-item:hover{filter:brightness(1.1);transform:scaleY(1.05)}
        .chart-bar-item:nth-child(even){background:var(--gradient-dark);opacity:.7}
        .chart-bar-item::after{content:attr(data-value);position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-size:10px;font-weight:600;color:var(--text-secondary);opacity:0;transition:opacity .3s}
        .chart-bar-item:hover::after{opacity:1}
        @keyframes chartGrow{from{transform:scaleY(0)}to{transform:scaleY(1)}}
        .dash-feed-area{display:flex;flex-direction:column;gap:10px}
        .feed-row{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--surface-elevated);border-radius:8px;border:1px solid var(--border-light);transition:all .3s;animation:feedSlideIn .5s ease-out;cursor:pointer}
        .feed-row:hover{border-color:var(--primary);transform:translateX(4px);box-shadow:0 2px 8px var(--shadow-color)}
        @keyframes feedSlideIn{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}
        .feed-badge{font-size:10px;font-weight:700;padding:4px 10px;border-radius:6px;white-space:nowrap;flex-shrink:0}
        .badge-hindu{background:#DCFCE7;color:#16A34A}.badge-toi{background:#FEF3C7;color:#D97706}.badge-et{background:#EDE9FE;color:#7C3AED}
        .feed-text{font-size:13px;color:var(--text-primary);line-height:1.4;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .feed-sentiment{font-size:10px;font-weight:700;padding:3px 10px;border-radius:999px;white-space:nowrap;flex-shrink:0}
        .sent-pos{background:#DCFCE7;color:#16A34A}.sent-neu{background:#F1F5F9;color:#64748B}.sent-neg{background:#FEE2E2;color:#DC2626}

        /* Float */
        .float-element{position:absolute;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px 22px;box-shadow:var(--card-shadow);font-size:13px;z-index:10}
        .float-top-right{top:-30px;right:-40px;animation:floatBob 5s ease-in-out infinite}
        .float-bottom-left{bottom:40px;left:-50px;animation:floatBob 5s ease-in-out infinite 1.5s}
        @keyframes floatBob{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-10px) rotate(1deg)}}
        .float-title{font-weight:700;color:var(--secondary);margin-bottom:6px;font-size:12px}
        .float-value{font-family:'Instrument Serif',Georgia,serif;font-size:28px;font-weight:600;color:var(--primary);line-height:1}
        .float-sub{color:var(--text-muted);font-size:11px;margin-top:4px}
        .float-sparkline{display:flex;gap:3px;align-items:flex-end;margin-top:10px;height:30px}
        .spark-bar{width:5px;border-radius:3px 3px 0 0;background:var(--primary);opacity:.3;transition:opacity .3s}
        .spark-bar.active{opacity:1}

        /* Marquee */
        .marquee-strip{background:var(--ticker-bg);padding:14px 0;overflow:hidden;position:relative}
        .marquee-strip::before,.marquee-strip::after{content:'';position:absolute;top:0;bottom:0;width:100px;z-index:2;pointer-events:none}
        .marquee-strip::before{left:0;background:linear-gradient(90deg,var(--ticker-bg),transparent)}
        .marquee-strip::after{right:0;background:linear-gradient(270deg,var(--ticker-bg),transparent)}
        .marquee-track{display:flex;animation:marqueeScroll 30s linear infinite;white-space:nowrap}
        .marquee-item{display:inline-flex;align-items:center;gap:12px;padding:0 40px;color:rgba(255,255,255,0.7);font-size:14px;font-weight:500}
        .marquee-item i{color:var(--primary-light);font-size:12px}
        .marquee-item strong{color:white;font-weight:600}
        @keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

        /* Credibility */
        .credibility-section{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:40px 0}
        .credibility-inner{max-width:1400px;margin:0 auto;padding:0 40px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}
        .cred-item{text-align:center;flex:1;min-width:140px}
        .cred-number{font-family:'Instrument Serif',Georgia,serif;font-size:32px;font-weight:600;color:var(--primary);line-height:1}
        .cred-label{font-size:12px;color:var(--text-muted);font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-top:6px}
        .cred-divider{width:1px;height:40px;background:var(--border)}

        /* Sections */
        .section-padding{padding:100px 0}
        .section-inner{max-width:1400px;margin:0 auto;padding:0 40px}
        .section-eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:12px;font-weight:700;letter-spacing:.15em;color:var(--primary);text-transform:uppercase;margin-bottom:20px}
        .section-eyebrow::before{content:'';width:24px;height:2px;background:var(--gradient-primary);border-radius:999px}
        .section-title{font-family:'Instrument Serif',Georgia,serif;font-size:clamp(32px,4vw,52px);font-weight:400;line-height:1.1;color:var(--text-primary);margin-bottom:16px;letter-spacing:-.02em}
        .section-subtitle{font-size:18px;color:var(--text-secondary);max-width:560px;line-height:1.7}

        /* News */
        .showcase-section{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
        .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
        .news-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px;transition:all .4s cubic-bezier(.23,1,.32,1);position:relative;overflow:hidden;cursor:pointer;text-decoration:none;color:inherit;display:block}
        .news-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-primary);transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.23,1,.32,1)}
        .news-card:hover{transform:translateY(-8px);box-shadow:var(--card-shadow),0 0 40px var(--primary-glow);border-color:rgba(255,107,53,0.3)}
        .news-card:hover::before{transform:scaleX(1)}
        .news-source{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--primary);text-transform:uppercase;margin-bottom:14px}
        .news-source-dot{width:6px;height:6px;border-radius:50%;background:var(--primary);animation:sourceBlink 2s ease-in-out infinite}
        @keyframes sourceBlink{0%,100%{opacity:1}50%{opacity:.4}}
        .news-headline{font-family:'Instrument Serif',Georgia,serif;font-size:20px;font-weight:400;line-height:1.35;color:var(--text-primary);margin-bottom:18px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
        .news-meta{display:flex;align-items:center;justify-content:space-between;margin-top:auto}
        .news-time{font-size:12px;color:var(--text-muted);font-weight:500}
        .news-link{font-size:13px;font-weight:600;color:var(--primary);display:flex;align-items:center;gap:6px;transition:gap .3s}
        .news-card:hover .news-link{gap:10px}
        .news-sentiment{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;padding:5px 12px;border-radius:999px;margin-bottom:14px}
        .news-loading{grid-column:1/-1;text-align:center;padding:80px}
        .news-loading-spinner{width:48px;height:48px;border:3px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spinnerRotate .8s linear infinite;margin:0 auto 20px}
        @keyframes spinnerRotate{to{transform:rotate(360deg)}}

        /* Features */
        .features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px}
        .feature-box{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:40px 32px;transition:all .4s cubic-bezier(.23,1,.32,1);position:relative;overflow:hidden}
        .feature-box::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,107,53,0.03),transparent 60%);opacity:0;transition:opacity .4s}
        .feature-box:hover{transform:translateY(-6px);box-shadow:var(--card-shadow);border-color:rgba(255,107,53,0.2)}
        .feature-box:hover::after{opacity:1}
        .feature-icon-wrap{width:64px;height:64px;background:linear-gradient(135deg,rgba(255,107,53,0.1),rgba(255,140,90,0.1));border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:28px;margin-bottom:24px;position:relative;z-index:1;transition:all .3s}
        .feature-box:hover .feature-icon-wrap{background:var(--gradient-primary);transform:scale(1.1);box-shadow:0 8px 24px rgba(255,107,53,0.3)}
        .feature-heading{font-family:'Instrument Serif',Georgia,serif;font-size:22px;font-weight:400;color:var(--text-primary);margin-bottom:12px;position:relative;z-index:1}
        .feature-desc{font-size:15px;color:var(--text-secondary);line-height:1.7;position:relative;z-index:1}

        /* Pulse */
        .pulse-section{background:var(--pulse-bg);padding:100px 0;overflow:hidden;position:relative}
        .pulse-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 100%,rgba(255,107,53,0.12) 0%,transparent 70%);pointer-events:none}
        .pulse-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;position:relative;z-index:1}
        .pulse-globe-wrap{display:flex;justify-content:center;align-items:center}
        .pulse-globe{position:relative;width:340px;height:340px}
        .globe-ring{position:absolute;border-radius:50%;border:2px solid rgba(255,107,53,0.2);animation:ringExpand 3s ease-out infinite}
        .globe-ring:nth-child(1){inset:0;animation-delay:0s}.globe-ring:nth-child(2){inset:-25px;animation-delay:.5s}.globe-ring:nth-child(3){inset:-50px;animation-delay:1s}.globe-ring:nth-child(4){inset:-75px;animation-delay:1.5s}.globe-ring:nth-child(5){inset:-100px;animation-delay:2s}
        @keyframes ringExpand{0%{opacity:.8;transform:scale(.9)}100%{opacity:0;transform:scale(1.15)}}
        .globe-core{position:absolute;inset:70px;background:var(--gradient-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;box-shadow:0 0 80px rgba(255,107,53,0.4);animation:coreGlow 3s ease-in-out infinite}
        @keyframes coreGlow{0%,100%{box-shadow:0 0 60px rgba(255,107,53,0.4)}50%{box-shadow:0 0 100px rgba(255,107,53,0.6)}}
        .globe-icon{font-size:48px;margin-bottom:8px}
        .globe-count{font-family:'Instrument Serif',Georgia,serif;font-size:28px;font-weight:600;color:white;line-height:1}
        .globe-label{font-size:11px;color:rgba(255,255,255,0.7);font-weight:600;letter-spacing:.1em;text-transform:uppercase}
        .pulse-nodes-wrap{position:absolute;inset:0}
        .pulse-node{position:absolute;width:12px;height:12px;background:var(--primary-light);border-radius:50%;animation:nodePulse 2s ease-in-out infinite;box-shadow:0 0 0 0 rgba(255,140,90,0.5)}
        @keyframes nodePulse{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(255,140,90,0.5)}50%{transform:scale(1.4);box-shadow:0 0 0 12px rgba(255,140,90,0)}}
        .pulse-feature{display:flex;align-items:flex-start;gap:18px;margin-bottom:28px}
        .pulse-feature-icon{width:48px;height:48px;background:rgba(255,107,53,0.15);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;color:var(--primary-light)}
        .pulse-feature-title{font-size:16px;font-weight:700;color:white;margin-bottom:6px}
        .pulse-feature-desc{font-size:14px;color:rgba(255,255,255,0.5);line-height:1.6}

        /* How */
        .how-section{background:var(--surface-elevated);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
        .steps-wrap{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:56px;position:relative}
        .steps-wrap::before{content:'';position:absolute;top:50px;left:calc(16.66% + 40px);right:calc(16.66% + 40px);height:2px;background:var(--gradient-primary);z-index:0;border-radius:999px}
        .step-box{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:48px 36px;text-align:center;position:relative;z-index:1;transition:all .4s}
        .step-box:hover{transform:translateY(-6px);box-shadow:var(--card-shadow);border-color:rgba(255,107,53,0.2)}
        .step-number{width:80px;height:80px;background:var(--gradient-primary);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Instrument Serif',Georgia,serif;font-size:36px;font-weight:600;margin:0 auto 28px;box-shadow:0 8px 24px rgba(255,107,53,0.3);transition:all .3s}
        .step-box:hover .step-number{transform:scale(1.1);box-shadow:0 12px 32px rgba(255,107,53,0.4)}
        .step-title{font-family:'Instrument Serif',Georgia,serif;font-size:24px;font-weight:400;margin-bottom:14px;color:var(--text-primary)}
        .step-desc{font-size:15px;color:var(--text-secondary);line-height:1.7}

        /* Coming */
        .coming-section{background:linear-gradient(135deg,var(--surface-elevated),var(--surface));border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
        .coming-box{max-width:720px;margin:0 auto;text-align:center;padding:100px 40px}
        .coming-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(255,200,87,0.15);border:1px solid rgba(255,200,87,0.3);color:var(--warning);padding:10px 24px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.08em;margin-bottom:36px}
        .coming-icon{font-size:72px;margin-bottom:28px;display:block;animation:wrenchWiggle 3s ease-in-out infinite}
        @keyframes wrenchWiggle{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}
        .coming-title{font-family:'Instrument Serif',Georgia,serif;font-size:44px;font-weight:400;letter-spacing:-.02em;color:var(--text-primary);margin-bottom:16px}
        .coming-title .accent{color:var(--primary);font-weight:600}
        .coming-sub{font-size:18px;color:var(--text-secondary);line-height:1.7;margin-bottom:40px}
        .coming-form{display:flex;gap:0;max-width:440px;margin:0 auto;border:2px solid var(--border);border-radius:12px;overflow:hidden;background:var(--surface);box-shadow:var(--card-shadow);transition:border-color .3s}
        .coming-form:focus-within{border-color:var(--primary)}
        .coming-form input{flex:1;padding:16px 24px;border:none;outline:none;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;color:var(--text-primary);background:transparent}
        .coming-form input::placeholder{color:var(--text-muted)}
        .coming-form button{background:var(--gradient-primary);color:white;border:none;padding:16px 28px;font-family:'Plus Jakarta Sans',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:opacity .2s}
        .coming-form button:hover{opacity:.9}
        .coming-plans{display:flex;gap:20px;justify-content:center;margin-top:48px}
        .plan-stub{flex:1;max-width:180px;background:var(--surface-elevated);border:2px dashed var(--border);border-radius:16px;padding:24px;text-align:center;position:relative;overflow:hidden;transition:all .3s}
        .plan-stub:hover{border-color:var(--primary);transform:translateY(-4px)}
        .plan-stub::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(0,0,0,0.02) 10px,rgba(0,0,0,0.02) 20px)}
        .plan-name{font-weight:700;color:var(--text-secondary);font-size:14px;position:relative;z-index:1}
        .plan-price{font-family:'Instrument Serif',Georgia,serif;font-size:28px;font-weight:600;color:var(--border);margin-top:8px;position:relative;z-index:1}
        .plan-tag{position:absolute;top:-1px;right:-1px;background:var(--warning);color:var(--secondary);font-size:10px;font-weight:700;padding:4px 12px;border-radius:0 16px 0 8px;z-index:2}

        /* Legal */
        .legal-section{background:var(--legal-bg);color:rgba(255,255,255,0.7)}
        .legal-inner{max-width:1400px;margin:0 auto;padding:80px 40px}
        .legal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:48px;margin-bottom:56px}
        .legal-block-title{font-family:'Instrument Serif',Georgia,serif;font-size:18px;font-weight:400;color:var(--primary-light);margin-bottom:16px}
        .legal-block ul{list-style:none;padding:0}
        .legal-block li{font-size:14px;line-height:2;color:rgba(255,255,255,0.5);position:relative;padding-left:20px}
        .legal-block li::before{content:'→';position:absolute;left:0;color:var(--primary);font-weight:700}
        .legal-divider{border:none;border-top:1px solid rgba(255,255,255,0.1);margin:0 0 40px}
        .legal-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:32px;flex-wrap:wrap}
        .legal-disclaimer{font-size:12px;color:rgba(255,255,255,0.3);max-width:700px;line-height:1.9}
        .legal-badges{display:flex;gap:12px;flex-wrap:wrap}
        .legal-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);padding:8px 16px;border-radius:8px;font-size:11px;font-weight:600;color:rgba(255,255,255,0.5);letter-spacing:.04em}

        /* Footer */
        .footer-section{background:var(--footer-bg);border-top:1px solid rgba(255,255,255,0.05)}
        .footer-inner{max-width:1400px;margin:0 auto;padding:72px 40px 40px}
        .footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:56px;margin-bottom:56px}
        .footer-brand-desc{font-size:14px;color:rgba(255,255,255,0.4);line-height:1.8;margin-top:20px;max-width:300px}
        .footer-social{display:flex;gap:12px;margin-top:24px}
        .footer-social a{width:40px;height:40px;background:rgba(255,255,255,0.06);border-radius:8px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.4);font-size:16px;text-decoration:none;transition:all .3s}
        .footer-social a:hover{background:var(--primary);color:white;transform:translateY(-3px)}
        .footer-col-title{font-size:12px;font-weight:700;letter-spacing:.12em;color:rgba(255,255,255,0.3);margin-bottom:24px;text-transform:uppercase}
        .footer-links{display:flex;flex-direction:column;gap:14px}
        .footer-links a{font-size:14px;color:rgba(255,255,255,0.5);text-decoration:none;transition:all .2s;display:flex;align-items:center;gap:8px}
        .footer-links a:hover{color:var(--primary-light);transform:translateX(4px)}
        .footer-bottom{border-top:1px solid rgba(255,255,255,0.05);padding-top:28px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
        .footer-copy{font-size:13px;color:rgba(255,255,255,0.25)}
        .footer-bottom-links{display:flex;gap:28px}
        .footer-bottom-links a{font-size:13px;color:rgba(255,255,255,0.3);text-decoration:none;transition:color .2s}
        .footer-bottom-links a:hover{color:var(--primary-light)}

        /* Scroll Top */
        #scrollTopBtn{position:fixed;bottom:32px;right:32px;width:48px;height:48px;background:var(--gradient-primary);color:white;border:none;border-radius:12px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;opacity:0;transition:all .3s;transform:translateY(20px);z-index:50;box-shadow:0 4px 16px rgba(255,107,53,0.4)}
        #scrollTopBtn.visible{opacity:1;transform:translateY(0)}
        #scrollTopBtn:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(255,107,53,0.5)}

        /* Toast */
        #toastNotification{position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(100px);background:var(--secondary);color:white;padding:16px 32px;border-radius:12px;font-size:14px;font-weight:500;z-index:200;transition:transform .5s cubic-bezier(.23,1,.32,1);box-shadow:var(--card-shadow);white-space:nowrap;border:1px solid rgba(255,255,255,0.1)}
        #toastNotification.show{transform:translateX(-50%) translateY(0)}

        /* Responsive */
        @media(max-width:1024px){
            .hero-content{grid-template-columns:1fr;gap:48px}.hero-visual{display:none}
            .news-grid{grid-template-columns:repeat(2,1fr)}.features-grid{grid-template-columns:repeat(2,1fr)}
            .steps-wrap{grid-template-columns:1fr}.steps-wrap::before{display:none}
            .pulse-grid{grid-template-columns:1fr;gap:48px}.footer-grid{grid-template-columns:1fr 1fr}
            .legal-grid{grid-template-columns:1fr 1fr}.credibility-inner{justify-content:center}
            .dash1-grid{grid-template-columns:repeat(2,1fr)}.dashboard-tabs{flex-wrap:wrap}
        }
        @media(max-width:768px){
            .navbar-inner{padding:0 20px}.nav-links{display:none}
            .hero-content{padding:48px 20px}.section-inner{padding:0 20px}
            .news-grid{grid-template-columns:1fr}.features-grid{grid-template-columns:1fr}
            .footer-grid{grid-template-columns:1fr}.legal-grid{grid-template-columns:1fr}
            .coming-plans{flex-direction:column;align-items:center}.cred-item{min-width:100px}
            .cred-divider{display:none}.dash1-grid{grid-template-columns:1fr}.clip-item{width:280px}
        }
    </style>

