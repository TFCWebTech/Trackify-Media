// NOTIFY ME — WITH LOCAL STORAGE
// ═══════════════════════════════════════════════════════════════
function notifyMe() {
    const email = document.getElementById('notifyEmail').value.trim();
    if (!email || !email.includes('@') || !email.includes('.')) {
        showToast('Please enter a valid email address.');
        return;
    }

    // Store in localStorage
    let subscribers = JSON.parse(localStorage.getItem('trackify-subscribers') || '[]');
    if (!subscribers.includes(email)) {
        subscribers.push(email);
        localStorage.setItem('trackify-subscribers', JSON.stringify(subscribers));
    }

    showToast('✅ You\'re on the list! We\'ll notify you when pricing launches.');
    document.getElementById('notifyEmail').value = '';

    console.log('Subscribers:', subscribers);
}

function showToast(msg) {
    const toast = document.getElementById('toastNotification');
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3800);
}

// ═══════════════════════════════════════════════════════════════
// DASHBOARD FEED ROTATION
// ═══════════════════════════════════════════════════════════════
const feedItems = [
    {badge:'badge-hindu',label:'THE HINDU',text:'Supreme Court upholds right to digital privacy in landmark ruling',sentiment:'positive',link:'https://www.thehindu.com/'},
    {badge:'badge-toi',label:'TOI',text:'Mumbai Metro Line 3 achieves 1 million passenger milestone',sentiment:'positive',link:'https://timesofindia.indiatimes.com/'},
    {badge:'badge-et',label:'ET',text:'Adani Ports reports 28% revenue growth in Q4 FY26',sentiment:'positive',link:'https://economictimes.indiatimes.com/'},
    {badge:'badge-hindu',label:'THE HINDU',text:'India-UAE trade corridor inaugurated by PM Modi in Abu Dhabi',sentiment:'neutral',link:'https://www.thehindu.com/'},
    {badge:'badge-toi',label:'TOI',text:'CBSE results 2026: Record 99.4% pass percentage in Class XII',sentiment:'positive',link:'https://timesofindia.indiatimes.com/'},
    {badge:'badge-et',label:'ET',text:'Reliance Jio launches 6G pilot in select metros',sentiment:'positive',link:'https://economictimes.indiatimes.com/'},
];
let feedIndex = 0;
function rotateFeed() {
    const feed = document.getElementById('dashFeedArea');
    if (!feed) return;
    const items = feed.querySelectorAll('.feed-row');
    const next = feedItems[feedIndex % feedItems.length];
    const newItem = document.createElement('div');
    newItem.className = 'feed-row';
    newItem.style.opacity = '0';
    newItem.style.transform = 'translateX(20px)';
    newItem.style.transition = 'all 0.4s ease';
    newItem.onclick = () => window.open(next.link, '_blank');
    const sentMap = {positive:'sent-pos',neutral:'sent-neu',negative:'sent-neg'};
    const sentLabel = {positive:'✓ Positive',neutral:'— Neutral',negative:'↓ Negative'};
    newItem.innerHTML = `
        <span class="feed-badge ${next.badge}">${next.label}</span>
        <span class="feed-text">${next.text}</span>
        <span class="feed-sentiment ${sentMap[next.sentiment]}">${sentLabel[next.sentiment]}</span>
    `;
    if (items.length >= 3) {
        items[0].style.transition = 'all 0.3s ease';
        items[0].style.opacity = '0';
        items[0].style.transform = 'translateX(-20px)';
        setTimeout(() => { if(items[0].parentNode) items[0].remove(); }, 300);
    }
    feed.appendChild(newItem);
    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            newItem.style.opacity = '1';
            newItem.style.transform = 'translateX(0)';
        });
    });
    feedIndex++;
}
setInterval(rotateFeed, 3500);

// ═══════════════════════════════════════════════════════════════
// ANIMATED METRIC COUNTERS FOR DASHBOARD
// ═══════════════════════════════════════════════════════════════
function animateDashboardMetrics() {
    const metrics = [
        {el:document.getElementById('metric1'),target:12847,suffix:''},
        {el:document.getElementById('metric2'),target:87.4,suffix:'%'},
        {el:document.getElementById('metric3'),target:2.4,suffix:'M'},
        {el:document.getElementById('metric4'),target:156,suffix:''}
    ];
    metrics.forEach(m => {
        if (!m.el) return;
        let current = 0;
        const step = m.target / 60;
        const interval = setInterval(() => {
            current = Math.min(current + step, m.target);
            m.el.textContent = (m.target < 100 ? current.toFixed(1) : Math.floor(current)).toLocaleString('en-IN') + m.suffix;
            if (current >= m.target) clearInterval(interval);
        }, 30);
    });
}

// Trigger dashboard metrics when section is visible
const dashObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            animateDashboardMetrics();
            dashObserver.disconnect();
        }
    });
}, {threshold: 0.3});

setTimeout(() => {
    const dashSection = document.querySelector('.dashboard-showcase');
    if (dashSection) dashObserver.observe(dashSection);
}, 1000);
</script>
