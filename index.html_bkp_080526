    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Playfair+Display:wght@700;900&amp;display=swap');

        :root {
            --saffron: #ff9933;
            --navy: #0a1f44;
            --teal: #00e5cc;
        }

        body.light {
            --saffron: #ff9933;
            --navy: #0a1f44;
            --teal: #00b894;
        }

        body {
            font-family: 'Inter', system_ui, sans-serif;
