        .hero-bg {
            background: linear-gradient(135deg, rgba(10,31,68,0.92), rgba(13,13,13,0.88)), url('https://picsum.photos/id/1015/2000/1200') center/cover fixed;
            animation: indiaPulse 25s ease-in-out infinite;
        }

        body.light .hero-bg {
            background: linear-gradient(135deg, rgba(250,250,245,0.95), rgba(248,244,235,0.92)), url('https://picsum.photos/id/1015/2000/1200') center/cover fixed;
        }

        @keyframes indiaPulse {
            0%, 100% { filter: brightness(1) hue-rotate(8deg); }
            50% { filter: brightness(1.18) hue-rotate(22deg); }
        }

        .newspaper-masthead {
            background: #f8f1e3;
            border: 12px solid #d4b88a;
            box-shadow: 0 25px 60px -15px rgba(0,0,0,0.6);
            animation: paperDrift 18s linear infinite;
        }

        @keyframes paperDrift {
            from { transform: translateX(0) rotate(-2deg); }
            to { transform: translateX(-120%) rotate(2deg); }
        }

        .ink-particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: #8b4513;
            border-radius: 50%;
            animation: inkDrop 4s linear infinite;
            opacity: 0.6;
        }

        @keyframes inkDrop {
            0% { transform: translateY(-300px) scale(0.2); opacity: 0; }
            30% { opacity: 0.9; }
            100% { transform: translateY(600px) scale(1.8); opacity: 0; }
        }

        .pulse-line {
            stroke: #ff9933;
            stroke-dasharray: 12 8;
            animation: dash 2s linear infinite;
        }

        @keyframes dash {
            to { stroke-dashoffset: -40; }
        }

        .login-btn-internal {
            background: linear-gradient(90deg, #0a1f44, #1e3a6e);
        }
        .login-btn-client {
            background: linear-gradient(90deg, #ff9933, #ff6600);
        }

        .rss-card {
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }
        .rss-card:hover {
            transform: translateY(-12px) scale(1.03);
